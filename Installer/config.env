# LabelWerk – zentrale Build- und Release-Konfiguration
#
# Einzige Quelle für Name, Bundle-ID, Version und Signaturidentitäten. Gelesen von
# Scripts/build_driver.sh, Scripts/build_app.sh, Scripts/make_pkg.sh, Scripts/notarize.sh und dem
# Makefile. Format: eine Zuweisung SCHLÜSSEL=Wert je Zeile, ohne Leerzeichen um „=“, keine
# Shell-Ausdrücke. Werte mit Leerzeichen dürfen in doppelte Anführungszeichen gesetzt werden.
#
# Jede Variable kann beim Aufruf über die Umgebung überschrieben werden, z. B.
#   VERSION=1.1.0 BUILD=42 make pkg
#   DEVELOPER_ID_APP="Developer ID Application: Beispiel GmbH (ABCDE12345)" make app

# Anzeigename der App (CFBundleName / CFBundleDisplayName, Paketname).
APP_NAME=LabelWerk

# Bundle-Kennung der App; die Paketkennungen werden daraus abgeleitet
# (<BUNDLE_ID>.pkg für die App, <BUNDLE_ID>.driver für den Treiber, <BUNDLE_ID>.cli für lwctl).
BUNDLE_ID=com.labelwerk.app

# Marketing-Version (CFBundleShortVersionString, VERSION-Datei des Treibers, Paketversion).
VERSION=1.0.0

# Fortlaufende Build-Nummer (CFBundleVersion), bei jeder veröffentlichten Version erhöhen.
BUILD=1

# Jahr im Copyright-Hinweis (NSHumanReadableCopyright, Installer-Texte).
COPYRIGHT_YEAR=2026

# Apple-Team-ID (zehn Zeichen) – nur für die Notarisierung mit Apple-ID/Passwort nötig.
TEAM_ID=

# Signaturidentitäten aus dem Schlüsselbund. Leer = ad-hoc-Signatur der App („-“) bzw.
# unsigniertes Installationspaket (nur für Entwicklung und CI geeignet).
#   DEVELOPER_ID_APP="Developer ID Application: Firma (TEAMID)"
#   DEVELOPER_ID_INSTALLER="Developer ID Installer: Firma (TEAMID)"
DEVELOPER_ID_APP=
DEVELOPER_ID_INSTALLER=
