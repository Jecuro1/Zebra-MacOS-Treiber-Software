#!/bin/bash
# shellcheck disable=SC1111  # Deutsche Anführungszeichen („…“) in Meldungen sind beabsichtigt.
#
# LabelWerk – postinstall der Treiberkomponente
#
# Wird vom macOS-Installer als root aufgerufen: $1 = Paketpfad, $2 = Zielort, $3 = Zielvolume.
#
#  1. Besitzer und Rechte festziehen: CUPS führt Filter und Backends nur aus, wenn sie root:wheel
#     gehören und weder für Gruppe noch für andere schreibbar sind (sonst „… has insecure
#     permissions“). Das Backend /usr/libexec/cups/backend/labelwerk erhält 0755: cupsd startet es
#     dann als unprivilegierten Benutzer _lp (0700 hieße root – nicht nötig, es öffnet nur eine
#     TCP-Verbindung zum Drucker).
#  2. Quarantäne-Attribute entfernen.
#  3. Nur auf dem Startvolume: cupsd neu starten, damit Filter und PPDs sofort bekannt sind, und
#     vorhandene LabelWerk-Warteschlangen auf die neuen PPDs aktualisieren. „lpadmin -P“ übernimmt
#     die Standardwerte der neuen PPD; die bisher gewählten Standardoptionen der Warteschlange
#     (Schwärzung, Etikettenformat …) werden deshalb aus ihrer alten PPD gelesen und im selben
#     Aufruf mit „-o“ wieder gesetzt. Werte, die die neue PPD nicht mehr kennt, verwirft lpadmin.
#     Eine von LabelWerk ergänzte Etikettengröße (*lwLabelPageSize, z. B. „Etikett 104 × 76,2 mm“)
#     wird in eine Kopie der neuen PPD übernommen – sonst verwürfe lpadmin ihre Seitengröße. Fehlen
#     der Warteschlange lwLabelWidth/lwLabelHeight (ältere Versionen), werden sie aus ihrer
#     Standard-Seitengröße gesetzt, damit „An Etikett anpassen“ (lwFitToLabel) greift
#     (ARCHITECTURE.md §9 „Etikettengröße der Warteschlange“).
#     Danach stellt es LabelWerk-Warteschlangen (PPD mit *lwModel) mit der Geräte-URI
#     socket://host:port auf labelwerk://host:port um – das Backend, mit dem ein Auftrag nach
#     Papier- oder Farbbandende weiterläuft (ARCHITECTURE.md §10 „Backend labelwerk“). Ausgenommen
#     sind Warteschlangen, für die der Benutzer das abgeschaltet hat (Warteschlangen-Standard
#     lwResumeOnError=False), und alle übrigen (USB, IPP, fremde Treiber).
#  4. Nur auf dem Startvolume, nur bei einer Installation mit dem Installationsprogramm
#     (Doppelklick auf das Paket) und nur, solange noch kein LabelWerk-Drucker eingerichtet ist
#     (also nicht bei einem Update): LabelWerk für den angemeldeten Benutzer mit „--setup“ öffnen –
#     wie ein Windows-Setup, das mit „Drucker einrichten“ endet. Dieses Skript läuft nach dem
#     Kopieren der App und nach dem cupsd-Neustart; die optionale lwctl-Komponente danach legt nur
#     noch einen Link an.
#
# Vorlage: Platzhalter in At-Zeichen (App-Name) ersetzt Scripts/make_pkg.sh aus Installer/config.env.
#
# Fehler beim Neustart, Aktualisieren oder Öffnen der App brechen die Installation nicht ab (der
# Treiber ist dann trotzdem installiert); sie werden in /var/log/install.log protokolliert.

set -euo pipefail

TARGET="${3:-/}"
TARGET="${TARGET%/}"
DRIVER_DIR="${TARGET}/Library/Printers/LabelWerk"
PPD_DIR="${TARGET}/Library/Printers/PPDs/Contents/Resources"
CUPS_PPD_DIR="${TARGET}/etc/cups/ppd"
BACKEND="${TARGET}/usr/libexec/cups/backend/labelwerk"
LPADMIN="/usr/sbin/lpadmin"
LPSTAT="/usr/bin/lpstat"
LPOPTIONS="/usr/bin/lpoptions"

log() {
    printf 'LabelWerk postinstall: %s\n' "$*"
}

if [[ ! -d "${DRIVER_DIR}/Filter" ]]; then
    log "Fehler: Filterordner fehlt (${DRIVER_DIR}/Filter)."
    exit 1
fi

# --- 1. Besitzer und Rechte ------------------------------------------------------------------
# Numerische IDs: 0:0 ist root:wheel auf macOS.
chown -R 0:0 "${DRIVER_DIR}"
find "${DRIVER_DIR}" -type d -exec chmod 755 {} +
find "${DRIVER_DIR}" -type f -exec chmod 644 {} +
for executable in "${DRIVER_DIR}"/Filter/* "${DRIVER_DIR}/uninstall.sh"; do
    [[ -f "${executable}" ]] || continue
    chmod 755 "${executable}"
done
ppd_count=0
for ppd in "${PPD_DIR}"/LabelWerk-*.ppd.gz "${PPD_DIR}"/LabelWerk-*.ppd; do
    [[ -f "${ppd}" ]] || continue
    chown 0:0 "${ppd}"
    chmod 644 "${ppd}"
    ppd_count=$((ppd_count + 1))
done
backend_note="kein Backend"
if [[ -f "${BACKEND}" ]]; then
    chown 0:0 "${BACKEND}"
    chmod 755 "${BACKEND}"
    backend_note="Backend labelwerk"
fi
log "Rechte gesetzt: $(find "${DRIVER_DIR}/Filter" -type f | wc -l | tr -d ' ') Filter, ${backend_note}, ${ppd_count} PPD-Dateien."

# --- 2. Quarantäne ---------------------------------------------------------------------------
if command -v xattr >/dev/null 2>&1; then
    xattr -dr com.apple.quarantine "${DRIVER_DIR}" 2>/dev/null || true
    if [[ -f "${BACKEND}" ]]; then
        xattr -d com.apple.quarantine "${BACKEND}" 2>/dev/null || true
    fi
fi

# --- 3. CUPS ---------------------------------------------------------------------------------
if [[ -n "${TARGET}" ]]; then
    log "Installation auf ${TARGET} (nicht das Startvolume) – CUPS wird nicht neu gestartet."
    exit 0
fi

restart_cups() {
    if launchctl kickstart -k system/org.cups.cupsd >/dev/null 2>&1; then
        log "cupsd neu gestartet (launchctl kickstart)."
    elif killall -HUP cupsd >/dev/null 2>&1; then
        log "cupsd zum Neuladen aufgefordert (SIGHUP)."
    else
        log "cupsd läuft nicht – CUPS startet bei Bedarf automatisch und lädt dann den neuen Treiber."
        return 1
    fi
    return 0
}

wait_for_scheduler() {
    local waited=0
    while (( waited < 15 )); do
        if LANG=C LC_ALL=C "${LPSTAT}" -r 2>/dev/null | grep -q 'is running'; then
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done
    return 1
}

# Gibt die Standardwerte aller Optionen (*OpenUI) einer PPD aus, je Zeile „Option=Wert“.
queue_defaults() {
    awk '
        { sub(/\r$/, "") }
        /^\*OpenUI[ \t]+\*/ {
            # „*OpenUI *PageSize/Media Size: PickOne“ → PageSize
            name = $2
            sub(/^\*/, "", name)
            sub(/:.*$/, "", name)
            slash = index(name, "/")
            if (slash > 0) name = substr(name, 1, slash - 1)
            if (name != "" && !(name in known)) { known[name] = 1; order[++count] = name }
            next
        }
        /^\*Default[^ \t:]+:/ {
            key = $0
            sub(/^\*Default/, "", key)
            sub(/:.*$/, "", key)
            value = $0
            sub(/^[^:]*:[ \t]*/, "", value)
            sub(/[ \t].*$/, "", value)
            if (!(key in defaults)) defaults[key] = value
        }
        END {
            for (i = 1; i <= count; i++) {
                name = order[i]
                if ((name in defaults) && defaults[name] != "") print name "=" defaults[name]
            }
        }
    ' "$1"
}

# Wie queue_defaults, bildet aber veraltete Optionen auf ihre Nachfolger ab: lwRotate180 steht
# nicht mehr in der PPD (lpadmin würde „-o lwRotate180=True“ stillschweigend verwerfen und die
# Warteschlange druckte mit 0°). „True“ wird zu lwRotation=180 – außer die alte PPD hatte schon
# eine Drehung ≠ 0 (die hat wie im Filter Vorrang); „False“ entfällt.
carried_defaults() {
    local default rotate180=0 rotation=""
    local -a entries=()
    while IFS= read -r default; do
        entries+=("${default}")
        case "${default}" in
            lwRotate180=[Tt][Rr][Uu][Ee]) rotate180=1 ;;
            lwRotation=*) rotation="${default#lwRotation=}" ;;
        esac
    done < <(queue_defaults "$1")
    for default in ${entries[@]+"${entries[@]}"}; do
        case "${default}" in
            lwRotate180=*|lwRotation=*) continue ;;
        esac
        printf '%s\n' "${default}"
    done
    if [[ -n "${rotation}" && "${rotation}" != "0" ]]; then
        printf 'lwRotation=%s\n' "${rotation}"
    elif (( rotate180 )); then
        printf 'lwRotation=180\n'
    elif [[ -n "${rotation}" ]]; then
        printf 'lwRotation=%s\n' "${rotation}"
    fi
}

# Gibt die von LabelWerk ergänzte Seitengröße einer Warteschlangen-PPD aus (*lwLabelPageSize,
# z. B. „w295h216“), sonst nichts.
added_page_size() {
    sed -n 's/^\*lwLabelPageSize:[[:space:]]*"\([A-Za-z0-9.]*\)".*/\1/p' "$1" | head -n 1
}

# Schreibt nach $3 eine Kopie der neuen PPD $2 (.ppd.gz oder .ppd) mit der ergänzten Seitengröße $4
# aus der Warteschlangen-PPD $1 – dasselbe Ergebnis wie QueuePPD.patched in App und lwctl: Die
# Einträge (*PageSize, *PageRegion, *ImageableArea, *PaperDimension) stehen direkt nach ihrer
# *Default…-Zeile, die auf die Größe zeigt, die deutschen Texte nach der Übersetzung der Option, die
# Markierung nach *lwModel. Kennt die neue PPD die Größe schon, werden nur die *Default…-Zeilen
# gesetzt. Rückgabewert ≠ 0, wenn der alten PPD Einträge fehlen oder die neue nicht lesbar ist.
patch_added_size() {
    local old_ppd="$1" new_ppd="$2" output="$3" keyword="$4" status=0
    case "${new_ppd}" in
        *.gz) gzip -dc "${new_ppd}" > "${output}.base" 2>/dev/null || status=1 ;;
        *) cp "${new_ppd}" "${output}.base" 2>/dev/null || status=1 ;;
    esac
    if (( status == 0 )); then
        LC_ALL=C awk -v keyword="${keyword}" -v old="${old_ppd}" '
            BEGIN {
                marker = "*% LabelWerk: Etikettengroesse dieser Warteschlange (von LabelWerk ergaenzt)"
                split("PageSize PageRegion ImageableArea PaperDimension de.PageSize de.PageRegion", mains, " ")
                while ((getline line < old) > 0) {
                    sub(/\r$/, "", line)
                    for (i = 1; i <= 6; i++) {
                        prefix = "*" mains[i] " " keyword "/"
                        if (!(mains[i] in entry) && substr(line, 1, length(prefix)) == prefix) entry[mains[i]] = line
                    }
                }
                close(old)
                for (i = 1; i <= 4; i++) if (!(mains[i] in entry)) { failed = 1; exit 1 }
            }
            {
                sub(/\r$/, "")
                text[++lines] = $0
                prefix = "*PageSize " keyword
                rest = substr($0, length(prefix) + 1, 1)
                if (substr($0, 1, length(prefix)) == prefix && (rest == "/" || rest == ":")) present = 1
            }
            END {
                if (failed) exit 1
                while (lines > 0 && text[lines] == "") lines--
                for (n = 1; n <= lines; n++) {
                    line = text[n]
                    done = 0
                    for (i = 1; i <= 4; i++) {
                        anchor = "*Default" mains[i] ":"
                        if (!(anchor in seen) && substr(line, 1, length(anchor)) == anchor) {
                            seen[anchor] = 1
                            print anchor " " keyword
                            if (!present) print entry[mains[i]]
                            done = 1
                        }
                    }
                    if (done) continue
                    print line
                    if (present) continue
                    for (i = 5; i <= 6; i++) {
                        anchor = "*de.Translation " substr(mains[i], 4) "/"
                        if (!(anchor in seen) && substr(line, 1, length(anchor)) == anchor) {
                            seen[anchor] = 1
                            if (mains[i] in entry) print entry[mains[i]]
                        }
                    }
                    if (!("*lwModel:" in seen) && substr(line, 1, 9) == "*lwModel:") {
                        seen["*lwModel:"] = 1
                        print marker
                        print "*lwLabelPageSize: \"" keyword "\""
                    }
                }
                for (i = 1; i <= 4; i++) if (!(("*Default" mains[i] ":") in seen)) exit 1
            }
        ' "${output}.base" > "${output}" || status=1
    fi
    rm -f "${output}.base"
    return "${status}"
}

# Gibt lwLabelWidth-default/lwLabelHeight-default (1/100 mm) aus der Standard-Seitengröße einer
# Warteschlangen-PPD aus (*DefaultPageSize und ihre *PaperDimension in Punkten, gerundet wie die
# App: Punkte · 2540 / 72); bei Endlosmaterial (*DefaultlwMediaTracking: Continuous) ohne Länge.
label_size_defaults() {
    LC_ALL=C awk '
        { sub(/\r$/, "") }
        /^\*DefaultPageSize:/ && size == "" { size = $2 }
        /^\*DefaultlwMediaTracking:/ && tracking == "" { tracking = $2 }
        /^\*PaperDimension[ \t]/ { dimension[++count] = $0 }
        END {
            if (size == "") exit 0
            for (i = 1; i <= count; i++) {
                line = dimension[i]
                spec = line
                sub(/^\*PaperDimension[ \t]+/, "", spec)
                sub(/[\/:].*$/, "", spec)
                if (spec != size) continue
                sub(/^[^"]*"/, "", line)
                sub(/".*$/, "", line)
                if (split(line, values, " ") != 2) exit 0
                width = int(values[1] * 2540 / 72 + 0.5)
                height = int(values[2] * 2540 / 72 + 0.5)
                if (width <= 0) exit 0
                print "lwLabelWidth-default=" width
                if (height > 0 && tracking != "Continuous") print "lwLabelHeight-default=" height
                exit 0
            }
        }
    ' "$1"
}

# Hat die Warteschlange schon lwLabelWidth als Standard (lpoptions -p)?
has_label_size() {
    "${LPOPTIONS}" -p "$1" 2>/dev/null | grep -Eq '(^|[[:space:]])lwLabelWidth='
}

# Aktualisiert Warteschlangen, deren PPD von LabelWerk stammt (*lwModel), auf die neue PPD und
# behält dabei ihre Standardoptionen (siehe oben, veraltete Optionen umgesetzt), eine ergänzte
# Etikettengröße und lwLabelWidth/lwLabelHeight.
refresh_queues() {
    local queue_ppd queue model dpi new_ppd default carried updated=0 skipped=0
    local added install_ppd work note
    local -a carry
    [[ -d "${CUPS_PPD_DIR}" ]] || return 0
    for queue_ppd in "${CUPS_PPD_DIR}"/*.ppd; do
        [[ -f "${queue_ppd}" ]] || continue
        grep -q '^\*lwModel:' "${queue_ppd}" || continue
        queue="$(basename "${queue_ppd}" .ppd)"
        model="$(sed -n 's/^\*lwModel:[[:space:]]*"\([^"]*\)".*/\1/p' "${queue_ppd}" | head -n 1)"
        dpi="$(sed -n 's/^\*DefaultResolution:[[:space:]]*\([0-9][0-9]*\)dpi.*/\1/p' "${queue_ppd}" | head -n 1)"
        new_ppd="${PPD_DIR}/LabelWerk-${model}-${dpi}dpi.ppd.gz"
        if [[ -z "${model}" || -z "${dpi}" || ! -f "${new_ppd}" ]]; then
            log "Warteschlange „${queue}“: keine passende neue PPD (${model:-?}, ${dpi:-?} dpi) – unverändert."
            skipped=$((skipped + 1))
            continue
        fi
        carry=()
        carried=0
        while IFS= read -r default; do
            carry+=(-o "${default}")
            carried=$((carried + 1))
        done < <(carried_defaults "${queue_ppd}")
        install_ppd="${new_ppd}"
        work=""
        note=""
        added="$(added_page_size "${queue_ppd}")"
        if [[ -n "${added}" ]]; then
            work="$(mktemp -d "${TMPDIR:-/tmp}/LabelWerk-ppd.XXXXXX")"
            if patch_added_size "${queue_ppd}" "${new_ppd}" "${work}/${queue}.ppd" "${added}"; then
                install_ppd="${work}/${queue}.ppd"
                note=", Etikettengröße ${added} beibehalten"
            else
                log "Warteschlange „${queue}“: ergänzte Etikettengröße ${added} nicht lesbar – es gilt die Standardgröße der neuen PPD."
            fi
        fi
        if ! has_label_size "${queue}"; then
            while IFS= read -r default; do
                carry+=(-o "${default}")
            done < <(label_size_defaults "${queue_ppd}")
        fi
        if "${LPADMIN}" -p "${queue}" -P "${install_ppd}" ${carry[@]+"${carry[@]}"} >/dev/null 2>&1; then
            log "Warteschlange „${queue}“ auf $(basename "${new_ppd}") aktualisiert (${carried} Standardwerte übernommen${note})."
            updated=$((updated + 1))
        else
            log "Warteschlange „${queue}“ konnte nicht aktualisiert werden (lpadmin-Fehler) – unverändert."
            skipped=$((skipped + 1))
        fi
        if [[ -n "${work}" ]]; then rm -rf "${work}"; fi
    done
    log "${updated} Warteschlangen aktualisiert, ${skipped} unverändert."
}

# Geräte-URI einer Warteschlange laut „lpstat -v <queue>“ („device for <queue>: <uri>“).
queue_device_uri() {
    LANG=C LC_ALL=C "${LPSTAT}" -v "$1" 2>/dev/null | awk -v prefix="device for $1: " '
        index($0, prefix) == 1 { print substr($0, length(prefix) + 1); exit }
    '
}

# Hat der Benutzer „Bei Papier- oder Farbbandende anhalten und fortsetzen“ für die Warteschlange
# abgeschaltet (Warteschlangen-Standard lwResumeOnError=False, von App bzw. lwctl gesetzt)?
resume_disabled() {
    "${LPOPTIONS}" -p "$1" 2>/dev/null | grep -Eiq '(^|[[:space:]])lwResumeOnError=(false|no|off|0)([[:space:]]|$)'
}

# Stellt LabelWerk-Warteschlangen von socket://host:port auf labelwerk://host:port um (nur
# Warteschlangen mit LabelWerk-PPD, nur socket://, nie bei abgeschaltetem Fortsetzen). Pfad und
# Optionen der socket-URI (?waiteof=…) entfallen; der Port bleibt (ohne Angabe 9100).
migrate_device_uris() {
    local queue_ppd queue uri rest authority migrated=0 kept=0
    if [[ ! -x "${BACKEND}" ]]; then
        log "Backend ${BACKEND} fehlt – Warteschlangen bleiben bei socket://."
        return 0
    fi
    [[ -d "${CUPS_PPD_DIR}" ]] || return 0
    for queue_ppd in "${CUPS_PPD_DIR}"/*.ppd; do
        [[ -f "${queue_ppd}" ]] || continue
        grep -q '^\*lwModel:' "${queue_ppd}" || continue
        queue="$(basename "${queue_ppd}" .ppd)"
        uri="$(queue_device_uri "${queue}")"
        case "${uri}" in
            socket://*) ;;
            *) continue ;;
        esac
        if resume_disabled "${queue}"; then
            kept=$((kept + 1))
            continue
        fi
        rest="${uri#socket://}"
        authority="${rest%%[/?#]*}"
        if [[ -z "${authority}" ]]; then
            continue
        fi
        if "${LPADMIN}" -p "${queue}" -v "labelwerk://${authority}" >/dev/null 2>&1; then
            log "Warteschlange „${queue}“: labelwerk://${authority} (Druck geht nach Papier- oder Farbbandende weiter)."
            migrated=$((migrated + 1))
        else
            log "Warteschlange „${queue}“ konnte nicht auf labelwerk:// umgestellt werden – bleibt bei ${uri}."
        fi
    done
    log "${migrated} Warteschlangen auf das Backend labelwerk umgestellt, ${kept} auf Wunsch bei socket://."
}

# --- 4. Einrichtungsassistent ----------------------------------------------------------------
SETUP_APP="/Applications/@APP_NAME@.app"  # wird von Scripts/make_pkg.sh aus Installer/config.env eingesetzt

# Gibt es schon eine Warteschlange mit LabelWerk-PPD (*lwModel)? Dann ist dies ein Update – die
# Drucker sind eingerichtet (und eben aktualisiert), der Assistent würde nur stören.
has_labelwerk_queues() {
    local queue_ppd
    for queue_ppd in "${CUPS_PPD_DIR}"/*.ppd; do
        [[ -f "${queue_ppd}" ]] || continue
        if grep -q '^\*lwModel:' "${queue_ppd}"; then
            return 0
        fi
    done
    return 1
}

# Gibt den an der grafischen Oberfläche angemeldeten Benutzer aus – nichts, wenn niemand angemeldet
# ist (Anmeldefenster, Systemassistent beim ersten Start, nur root).
console_user() {
    local user
    user="$(stat -f%Su /dev/console 2>/dev/null || true)"
    case "${user}" in
        ""|root|loginwindow|_mbsetupuser) return 0 ;;
    esac
    printf '%s\n' "${user}"
}

# Öffnet LabelWerk mit „--setup“ für den angemeldeten Benutzer (die App startet dann den
# Einrichtungsassistenten zum Installieren von Druckern). Nie bei Installationen über die
# Kommandozeile: „installer“ setzt COMMAND_LINE_INSTALL – so auch Softwareverteilung, MDM und CI.
# Nie bei einem Update, d. h. wenn schon LabelWerk-Drucker eingerichtet sind.
# Läuft die App unter dem Benutzer (nicht als root): „launchctl asuser“ wechselt in seine
# Anmeldesitzung, „sudo -u“ zu seiner Kennung. Gibt immer 0 zurück – bestenfalls, nie ein Abbruch.
open_setup_assistant() {
    local user uid
    if [[ -n "${COMMAND_LINE_INSTALL:-}" ]]; then
        log "Installation über die Kommandozeile – der Einrichtungsassistent wird nicht geöffnet."
        return 0
    fi
    if has_labelwerk_queues; then
        log "LabelWerk-Drucker sind bereits eingerichtet (Update) – der Einrichtungsassistent wird nicht geöffnet."
        return 0
    fi
    if [[ ! -d "${SETUP_APP}" ]]; then
        log "${SETUP_APP} fehlt – der Einrichtungsassistent wird nicht geöffnet."
        return 0
    fi
    user="$(console_user)"
    if [[ -z "${user}" ]]; then
        log "Kein Benutzer angemeldet – der Einrichtungsassistent wird nicht geöffnet."
        return 0
    fi
    uid="$(id -u "${user}" 2>/dev/null || true)"
    case "${uid}" in
        ""|0|*[!0-9]*)
            log "Benutzerkennung von „${user}“ unbekannt – der Einrichtungsassistent wird nicht geöffnet."
            return 0
            ;;
    esac
    if launchctl asuser "${uid}" sudo -u "${user}" /usr/bin/open -a "${SETUP_APP}" --args --setup >/dev/null 2>&1; then
        log "Einrichtungsassistent für „${user}“ geöffnet (${SETUP_APP} --setup)."
    else
        log "Einrichtungsassistent konnte nicht geöffnet werden – bitte ${SETUP_APP} selbst öffnen."
    fi
    return 0
}

if restart_cups; then
    if wait_for_scheduler; then
        refresh_queues
        migrate_device_uris
    else
        log "CUPS antwortet nicht – vorhandene Warteschlangen werden nicht aktualisiert."
    fi
fi
open_setup_assistant || true
exit 0
